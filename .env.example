# Copy to .env next to docker-compose.yml and fill in.
# No secrets are required: the model runs locally.

# --- local model -----------------------------------------------------------
# OpenAI-compatible endpoint. Host runs: ollama listens on 127.0.0.1:11434.
# Compose reaches the host through host.docker.internal (mapped to the host
# gateway in docker-compose.yml); the host service must listen beyond
# loopback: OLLAMA_HOST=0.0.0.0:11434.
# TRIAGE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# TRIAGE_MODEL_NAME=ornith-9b-agent:latest
# Built from agent/Modelfile.ornith: see agent/README.md.
# TRIAGE_MODEL_API_KEY=
#
# Runtime knobs (defaults shown).
# TRIAGE_LOCAL_MAX_TOKENS=4096
# TRIAGE_LOCAL_TEMPERATURE=0.6
# TRIAGE_LOCAL_CONTEXT=65536
# TRIAGE_LOCAL_REASONING_EFFORT=none

# --- watcher ---------------------------------------------------------------
# Parent directory holding the trustsight/ and trustsight-harness/ checkouts.
# TRIAGE_WORKSPACE=/home/you/Documents/GitHub/trustsight
# TRIAGE_STATE_DIR=/home/you/.local/state/trustsight-triage
# TRIAGE_INTERVAL=300
# Render the confirmed-IOC envelope (alert.json) for TP verdicts.
# TRIAGE_ALERT=1
# Optional: second harness checkout for the legacy FP-reproducer path.
# The triage route does not need it; omit and the rbg server is skipped.
# TRIAGE_RBG_REPO=/home/you/Documents/GitHub/harness

# --- docker ----------------------------------------------------------------
# Explicit resolver: on hosts whose /etc/resolv.conf points at a loopback
# stub (systemd-resolved 127.0.0.53) Docker's embedded DNS forwards to an
# unreachable target and every lookup fails.
# TRIAGE_DOCKER_DNS=1.1.1.1
