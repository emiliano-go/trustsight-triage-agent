# Copy to .env next to docker-compose.yml and fill in.
# NEVER commit the real .env.

# Required. GitHub token used by the agent's PR step and the PR backstop.
# A fine-grained PAT limited to contents+pull_requests on the target repo
# is enough. Without it both services start, log a warning, and idle.
GITHUB_TOKEN=

# Optional: base64 PKCS#8 (DER) Ed25519 key for signed TP feed alerts.
# Without it the feed sink is skipped and only ntfy is tried.
TRUSTSIGHT_FEED_KEY=
TRUSTSIGHT_FEED_KEY_ID=triage-agent

# Optional: ntfy webhook URL for confirmed-IOC alerts.
TRUSTSIGHT_NTFY_WEBHOOK=

# Optional: override the feed sink (default https://watcher.trustsight.org).
# TRUSTSIGHT_FEED_URL=

# Optional: model route (default opencode/mimo-v2.6-flash-free).
# TRIAGE_MODEL=

# Optional: repo owner for PR discovery by branch (default: unset).
# TRIAGE_GITHUB_OWNER=
