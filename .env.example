# Copy to .env next to docker-compose.yml and fill in.
# NEVER commit the real .env.

# Required. GitHub token used by the agent's PR step and the PR backstop.
# A fine-grained PAT limited to contents+pull_requests on the target repo
# is enough. Without it both services start, log a warning, and idle.
GITHUB_TOKEN=

# Optional: host gid owning /var/run/docker.sock (worker needs it to spawn
# job containers). Find with: stat -c %g /var/run/docker.sock
# TRIAGE_DOCKER_GID=988

# Optional: base64 PKCS#8 (DER) Ed25519 key for signed TP feed alerts.
# Without it the feed sink is skipped and only ntfy is tried.
TRUSTSIGHT_FEED_KEY=
TRUSTSIGHT_FEED_KEY_ID=triage-agent

# Optional: ntfy webhook URL for confirmed-IOC alerts.
TRUSTSIGHT_NTFY_WEBHOOK=

# Optional: override the feed sink (default https://watcher.trustsight.org).
# TRUSTSIGHT_FEED_URL=

# Model backend (TRIAGE_MODEL_PROFILE, default "zen").
# One opencode mount, N backends: the agent's opencode.json is rendered per
# job from the profile, so switching needs no code change or rebuild.
#
# Profile "zen" (default): OpenCode Zen free route, MiMo-V2.6 flash-free
# with the Zen fallback ladder. Optional explicit override of the profile's
# model (leave unset to let the profile choose):
# TRIAGE_MODEL=opencode/mimo-v2.6-flash-free
#
# Profile "openai-compatible": any OpenAI-compatible endpoint. Examples:
#
#   NVIDIA NIM (benchmarks: burst OK, sustained ~50% HTTP 500 flapping;
#   test before relying on it):
#     TRIAGE_MODEL_PROFILE=openai-compatible
#     TRIAGE_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#     TRIAGE_MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b
#     NVIDIA_API_KEY=...
#     TRIAGE_MODEL_REASONING=1
#
#   OpenRouter free tier (50 req/day cap):
#     TRIAGE_MODEL_PROFILE=openai-compatible
#     TRIAGE_MODEL_BASE_URL=https://openrouter.ai/api/v1
#     TRIAGE_MODEL_NAME=meta-llama/llama-3.3-70b:free
#     OPENROUTER_API_KEY=...
#
#   Local AI (ollama; no key needed). Reach the host from job containers
#   via host.docker.internal (Docker Desktop) or the host gateway IP:
#     TRIAGE_MODEL_PROFILE=openai-compatible
#     TRIAGE_MODEL_BASE_URL=http://host.docker.internal:11434/v1
#     TRIAGE_MODEL_NAME=qwen3:8b
#
#   llama.cpp server / vLLM / LM Studio expose the same /v1 shape; point
#   TRIAGE_MODEL_BASE_URL at them exactly like ollama above.
#
# Optional for openai-compatible: comma-separated fallback model names on
# the SAME endpoint (rendered as opencode fallback_models):
# TRIAGE_MODEL_FALLBACKS=backup-model,other-model
#
# API keys are referenced as {env:NAME} (first present of TRIAGE_MODEL_API_KEY,
# NVIDIA_API_KEY, OPENROUTER_API_KEY) and passed to job containers as bare
# env vars; never written to disk, logs, or the image.
TRIAGE_MODEL_PROFILE=zen

# Optional: pre-flight gateway probe (default true). One trivial opencode
# call before each job claim; in a Zen dead window the worker backs off
# ~5-15 min and re-probes instead of burning the job's retries.
# TRIAGE_PREFLIGHT_PROBE=true

# Required for the default "zen" profile (OpenCode Zen route). Copy from
# `opencode auth` / ~/.local/share/opencode/auth.json ("opencode-go" key).
# OPENCODE_API_KEY=

# Warp rotation inside job containers (default true). Set false if the
# model gateway rejects WARP egress (symptom: every model call fails with
# the opencode server's UnknownError while warp shows Connected).
# TRIAGE_WARP_ROTATION=false

# Optional: repo owner for PR discovery by branch (default: unset).
# TRIAGE_GITHUB_OWNER=
