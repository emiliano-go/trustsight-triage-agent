{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/MiMo-V2.6-Flash",
  "agent": {
    "triage": {
      "mode": "primary",
      "model": "opencode/MiMo-V2.6-Flash",
      "fallback_models": [
        "opencode/grok-code",
        "opencode/kimi-k2-thinking"
      ],
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    }
  },
  "mcp": {
    "harness": {
      "type": "local",
      "command": [
        "/app/trustsight-harness/.venv/bin/harness-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio",
        "--toolsets",
        "repos:contents,repos:pull_requests"
      ],
      "enabled": true
    }
  }
}
