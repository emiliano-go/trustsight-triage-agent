{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "agent": {
    "triage": {
      "mode": "primary",
      "model": "opencode/mimo-v2.6-flash-free",
      "fallback_models": [
        "opencode/glm-5.3-flash-free",
        "opencode/nemotron-3.5-lightning-free"
      ],
      "tools": {
        "bash": false,
        "edit": false,
        "write": false
      }
    }
  },
  "mcp": {
    "harness": {
      "type": "local",
      "command": [
        "/app/trustsight-harness/.venv/bin/harness-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio",
        "--toolsets",
        "repos:contents,repos:pull_requests"
      ],
      "enabled": true
    },
    "aur": {
      "type": "local",
      "command": [
        "/app/trustsight-triage-agent/.venv/bin/python",
        "-m",
        "triage_agent.aur_mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  }
}
